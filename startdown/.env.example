GROQ_API_KEY=your_groq_api_key
# Optional: override the Groq model. The default is a current production model.
GROQ_MODEL=openai/gpt-oss-120b
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
# Some Vercel integrations use KV_REST_API_URL and KV_REST_API_TOKEN instead.
# Optional: change the Redis list key without changing the code.
REDIS_WALL_KEY=startdown:wall

# Server-only limits. Rolling windows; failed generation attempts also count.
ROASTS_PER_MINUTE=3
ROASTS_PER_DAY=10
ROASTS_SITE_PER_DAY=100
